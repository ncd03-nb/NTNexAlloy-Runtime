diff --git a/app/src/main/java/io/github/nexalloy/revanced/messenger/MessengerHook.kt b/app/src/main/java/io/github/nexalloy/revanced/messenger/MessengerHook.kt
new file mode 100644
index 00000000..318d4744
--- /dev/null
+++ b/app/src/main/java/io/github/nexalloy/revanced/messenger/MessengerHook.kt
@@ -0,0 +1,87 @@
+package io.github.nexalloy.revanced.messenger
+
+import app.morphe.extension.shared.Logger
+import io.github.nexalloy.hookMethod
+import io.github.nexalloy.morphe.findMethodListDirect
+import io.github.nexalloy.patch
+import java.lang.reflect.Modifier
+
+const val MESSENGER_PACKAGE_NAME = "com.facebook.orca"
+private const val ADS_ITEM = "com.facebook.messaging.business.inboxads.common.InboxAdsItem"
+private const val MARK_PARAMS = "com.facebook.messaging.service.model.MarkThreadsParams"
+
+val readDispatch = findMethodListDirect {
+    findMethod { matcher { usingEqStrings("markThreadsParams", "android_messaging_mark_read_t_start", "mark_threads") } }
+        .filter { it.returnTypeName == "void" && MARK_PARAMS in it.paramTypeNames }
+}
+
+val typingDispatch = findMethodListDirect {
+    findMethod { matcher { usingEqStrings("setTypingIndicatorForThreadWithThreadIdentifier") } }
+        .filter { it.paramTypeNames == listOf("java.lang.String", "boolean") && !Modifier.isStatic(it.modifiers) }
+}
+
+val HideMessengerAds = patch(
+    name = "Hide ads",
+    description = "Filters sponsored InboxAdsItem rows from Messenger inbox lists.",
+) {
+    val adClass = classLoader.loadClass(ADS_ITEM)
+    val builder = classLoader.loadClass("com.google.common.collect.ImmutableList\$Builder")
+    // Keep the builder's return type and ordinary messages intact.
+    builder.declaredMethods.filter { it.name == "add" && it.parameterTypes.contentEquals(arrayOf(Any::class.java)) }
+        .forEach { method -> method.hookMethod { before { if (adClass.isInstance(it.args[0])) it.result = it.thisObject } } }
+    java.util.ArrayList::class.java.getDeclaredMethod("add", Any::class.java).hookMethod {
+        before { if (adClass.isInstance(it.args[0])) it.result = false }
+    }
+    java.util.ArrayList::class.java.getDeclaredMethod("add", Int::class.javaPrimitiveType, Any::class.java).hookMethod {
+        before { if (adClass.isInstance(it.args[1])) it.result = null }
+    }
+    fun filtered(collection: Collection<*>): Collection<*> =
+        if (collection.any { adClass.isInstance(it) }) collection.filterNot { adClass.isInstance(it) } else collection
+    for (method in java.util.ArrayList::class.java.declaredMethods.filter { it.name == "addAll" }) {
+        method.hookMethod { before { param ->
+            val index = param.args.indexOfFirst { it is Collection<*> }
+            if (index >= 0) param.args[index] = filtered(param.args[index] as Collection<*>)
+        } }
+    }
+    builder.declaredMethods.filter { it.name == "addAll" && it.parameterTypes.contentEquals(arrayOf(Iterable::class.java)) }
+        .forEach { method -> method.hookMethod { before { param ->
+            val values = (param.args[0] as Iterable<*>).toList()
+            param.args[0] = filtered(values)
+        } } }
+    Logger.printInfo { "Messenger sponsored inbox list filters installed" }
+}
+
+val DisableMessengerReadReceipts = patch(
+    name = "Disable read receipts",
+    description = "Stops outgoing read dispatch while retaining the local inbox update and notification handling.",
+) {
+    val methods = ::readDispatch.dexMethodList
+    check(methods.size == 1) { "Messenger outgoing read dispatch is missing or ambiguous" }
+    val method = methods.single().toMethod()
+    val argument = method.parameterTypes.indexOfFirst { it.name == MARK_PARAMS }
+    // In the inspected APK, the sole Integer field is the operation: 0 = read, 1 = unread.
+    val operation = method.parameterTypes[argument].declaredFields.single { it.type == Integer::class.java }
+        .apply { isAccessible = true }
+    method.hookMethod { before { param ->
+        if ((operation.get(param.args[argument]) as? Int) == 0) {
+            param.result = null
+            Logger.printInfo { "Messenger outgoing read dispatch blocked" }
+        }
+    } }
+    Logger.printInfo { "Messenger outgoing read dispatch hook installed" }
+}
+
+val DisableMessengerTyping = patch(
+    name = "Disable typing status",
+    description = "Forces outgoing typing state to stopped without cancelling the mailbox callback.",
+) {
+    val methods = ::typingDispatch.dexMethodList
+    check(methods.size == 1) { "Messenger outgoing typing dispatch is missing or ambiguous" }
+    methods.single().hookMethod { before { param ->
+        if (param.args[1] == true) Logger.printInfo { "Messenger outgoing typing start suppressed" }
+        param.args[1] = false
+    } }
+    Logger.printInfo { "Messenger outgoing typing hook installed" }
+}
+
+val MessengerPatches = arrayOf(HideMessengerAds, DisableMessengerReadReceipts, DisableMessengerTyping)
