@@ -63,7 +63,26 @@ val backgroundPlaybackSettingsFingerprint = fingerprint {
 }
 
 val backgroundPlaybackSettingsSubFingerprint = findMethodDirect {
-    backgroundPlaybackSettingsFingerprint().invokes.filter { it.returnTypeName == "boolean" }[1]
+    runCatching {
+        backgroundPlaybackSettingsFingerprint().invokes.filter { it.returnTypeName == "boolean" }[1]
+    }.getOrElse {
+        // 21.41 builds the label inside a merged Function<Boolean, Object>.
+        // Search only the branch leading to this resource literal. Other switch
+        // branches invoke unrelated boolean methods; Boolean.booleanValue is
+        // unboxing the function argument, not the category gate.
+        val label = fingerprint {
+            accessFlags(AccessFlags.PUBLIC, AccessFlags.FINAL)
+            returns("Ljava/lang/Object;")
+            parameters("Ljava/lang/Object;")
+            literal { prefBackgroundAndOfflineCategoryId }
+        }
+        label.instructions.takeWhile { it.literal != prefBackgroundAndOfflineCategoryId.toLong() }
+            .mapNotNull { it.methodRef }
+            .filter {
+                it.returnTypeName == "boolean" && it.paramTypes.isEmpty() &&
+                    it.declaredClass!!.name != "java.lang.Boolean"
+            }.distinctBy { it.descriptor }.single()
+    }
 }
 
